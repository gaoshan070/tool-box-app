{
  "name": "tool-box",
  "version": "1.0.0",
  "description": "Online tool box for CloudFlare Workers - Local Development",
  "main": "src/worker.js",
  "scripts": {
    "dev:wrangler": "wrangler dev src/worker.js --port 8787 --inspector-port=0",
    "dev:express": "node local-server.js",
    "start": "node local-server.js",
    "build": "echo 'No build step needed'",
    "healthcheck": "node scripts/health-check.js",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^2.0.2"
  }
}